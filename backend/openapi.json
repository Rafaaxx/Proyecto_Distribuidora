    "/api/v1/identidad/dispositivos": {
      "get": {
        "tags": [
          "identidad"
        ],
        "summary": "Listar Dispositivos",
        "description": "Escenario \"El listado incluye solo los dispositivos propios\": la\norganización es la del token, no puede pedirse otra (tarea 10.4).",
        "operationId": "listar_dispositivos_api_v1_identidad_dispositivos_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DispositivoResponse"
                  },
                  "title": "Response Listar Dispositivos Api V1 Identidad Dispositivos Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/identidad/dispositivos/{dispositivo_id}": {
      "delete": {
        "tags": [
          "identidad"
        ],
        "summary": "Revocar Dispositivo",
        "description": "`revocar_dispositivo` del servicio devuelve `None` si `dispositivo_id`\nno pertenece a `contexto.organizacion_id` (INV-21): acá se traduce en\n`RecursoNoEncontradoError` (404, SEG-07), igual que el resto de las\nrutas de este archivo -- nunca un 204 silencioso, que dejaría creer que\nla revocación tuvo efecto sobre un recurso ajeno cuando en realidad no\ntocó nada (spec `dispositivos`, escenario \"Revocar un dispositivo de\notra organización no lo encuentra\").",
        "operationId": "revocar_dispositivo_api_v1_identidad_dispositivos__dispositivo_id__delete",
        "parameters": [
          {
            "name": "dispositivo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Dispositivo Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
