# Archivo de entorno de PRODUCCION: plantilla (change 27a, D1, D8; ADR-071).
#
# 1. Copie este archivo FUERA del repositorio (nunca lo suba a git con valores reales):
#      - PC de la oficina (Windows): por ejemplo C:\distribuidora\produccion.env
#      - Servidor Linux:             /etc/distribuidora/produccion.env  (permisos 600)
# 2. Complete los valores. Los secretos van VACIOS aca; genere cada uno con:
#      openssl rand -hex 32
#    Cada secreto debe ser distinto de los demas. Si falta alguno, el sistema no arranca y
#    avisa cual.
# 3. Levante el sistema indicando el archivo:
#      docker compose -f docker-compose.prod.yml --env-file <su-archivo> up -d --build
#
# No ponga espacios alrededor del "=" ni comillas.

# --- Donde y como se sirve (D1) ----------------------------------------------------------

# Direccion con la que la gente entra al sistema. Una de estas tres:
#   - un dominio (servidor con dominio):   app.sudominio.com.ar
#   - la IP fija de la PC en su red local: 192.168.1.50
#   - localhost (solo para ensayar en la propia PC)
DOMINIO=

# Quien emite el certificado del candado HTTPS. Una de estas dos:
#   internal            Caddy firma el certificado con su propia autoridad. Sirve para la PC de
#                       la oficina y para localhost. Cada telefono debe instalar y aceptar una
#                       vez el certificado raiz de Caddy (ver el runbook).
#   un correo           Let's Encrypt (autoridad publica y gratuita): para un dominio real.
#                       Ejemplo: sistemas@sudominio.com.ar. El correo recibe los avisos de
#                       vencimiento. Los telefonos no instalan nada.
CADDY_TLS=

# --- Version y funcionamiento ------------------------------------------------------------

# Version que se esta desplegando, con tres numeros: 0.27.0. Es la misma para el backend y para
# la aplicacion de los telefonos (si no tiene esa forma, el backend no arranca).
APP_VERSION=

# Cantidad de procesos del backend (2 alcanza para empezar).
WEB_CONCURRENCY=2

# Detalle de los registros: INFO normal, DEBUG para investigar un problema.
LOG_LEVEL=INFO

# Nombre del superusuario y de la base de PostgreSQL. No los cambie una vez creada la base.
POSTGRES_USER=distribuidora
POSTGRES_DB=distribuidora

# Identificador de la clave que firma las sesiones; cambiarlo solo al rotar JWT_SECRET.
JWT_KID=1

# --- Secretos (VACIOS aca; generelos con openssl rand -hex 32) ---------------------------

# Contrasena del superusuario de PostgreSQL (solo lo usa la base para inicializarse).
POSTGRES_PASSWORD=

# Contrasena del usuario que aplica las migraciones (dueño del esquema).
APP_MIGRATIONS_DB_PASSWORD=

# Contrasena del usuario con el que trabaja la aplicacion (no puede borrar libros).
APP_RUNTIME_DB_PASSWORD=

# Contrasena del usuario de solo lectura de los backups.
APP_BACKUP_DB_PASSWORD=

# Secreto que firma las sesiones (al menos 32 caracteres).
JWT_SECRET=

# --- Backups -----------------------------------------------------------------------------

# Carpeta del equipo donde quedan los backups (debe existir).
#   Servidor Linux: /var/backups/distribuidora
#   PC Windows:     una carpeta como C:/distribuidora/backups (con barras comunes)
BACKUP_DIR=/var/backups/distribuidora

# Hora diaria del backup (HH:MM), en la zona horaria TZ.
BACKUP_HORA=03:00

# Retencion: se conserva el backup mas reciente de cada uno de los ultimos BACKUP_DIARIOS dias
# que tienen backup y de cada una de las ultimas BACKUP_SEMANALES semanas (lunes a domingo).
BACKUP_DIARIOS=14
BACKUP_SEMANALES=8

# Usuario sin privilegios con el que corre el servicio de backup (el usuario `postgres` de la
# imagen). En Linux la carpeta BACKUP_DIR debe pertenecerle:
#   sudo chown 999:999 /var/backups/distribuidora
# En Windows con Docker Desktop no hace falta cambiar nada.
BACKUP_UID=999
BACKUP_GID=999

# Prueba de restauracion mensual (27b; D10): una vez por mes, el dia PRUEBA_DIA a la hora
# PRUEBA_HORA (en la zona TZ), un servicio aparte, sin red, restaura el ultimo backup en un
# servidor temporal propio, comprueba que los datos coinciden y lo descarta. Dia de 1 a 31 (en un
# mes mas corto se usa el ultimo dia).
PRUEBA_DIA=1
PRUEBA_HORA=04:00

# --- Copia externa de los backups (27b; D2 a D7, D14) -----------------------------------------

# Cada backup valido se copia, CIFRADO en el equipo antes de salir, a un lugar fuera de la PC.
# Sin la clave de cifrado (COPIA_CLAVE_CIFRADO y COPIA_SAL_CIFRADO) esas copias NO se pueden
# leer, ni siquiera el proveedor: guarde una copia de estas dos variables y del acceso al
# almacenamiento FUERA de la PC (gestor de contraseñas o sobre cerrado). Si se pierde la PC y no
# esta esa copia, las copias externas quedan inutilizables.

# Donde se guarda la copia. Una de estas dos:
#   s3      almacenamiento compatible con S3 (Backblaze B2, Cloudflare R2, Wasabi...).
#   local   una carpeta del propio equipo: SOLO para ensayar sin cuenta (no protege de perder la PC).
COPIA_TIPO=s3

# s3: nombre del cubo, y opcionalmente una carpeta dentro (por ejemplo mi-cubo/distribuidora).
# local (ensayo): una ruta DENTRO de /destino-local, por ejemplo /destino-local/copias.
COPIA_RUTA=

# Solo con s3: direccion del servicio (la muestra el proveedor; B2 por ejemplo:
# https://s3.us-west-004.backblazeb2.com), su region y, si no es "Other", su nombre en rclone.
COPIA_S3_ENDPOINT=
COPIA_S3_REGION=
COPIA_S3_PROVEEDOR=Other

# Solo para el ensayo local: carpeta del equipo (con barras comunes) que hace de destino. Si se
# deja asi, se usa un volumen de Docker. Con s3 no se usa.
#   Ejemplo PC Windows: C:/distribuidora/destino-ensayo
COPIA_LOCAL_DIR=copia_local

# Aviso opcional: si tiene una direccion (por ejemplo la de un control de "hombre muerto" como
# healthchecks.io), la copia la llama despues de cada corrida buena y a <direccion>/fail si
# falla. Vacia: no se avisa nada.
AVISO_URL=

# --- Secretos de la copia externa (VACIOS aca) -------------------------------------------------

# Clave de acceso y clave secreta del cubo (cree una clave que solo tenga permiso sobre ese
# cubo). En el ensayo local no se usan, pero no pueden quedar vacias: escriba no-aplica.
COPIA_ACCESS_KEY_ID=
COPIA_SECRET_ACCESS_KEY=

# Clave y sal del cifrado, ya "ofuscadas" con rclone (NO ponga aca la frase en claro). Para cada
# una, invente una frase larga y distinta y genere el valor con:
#   docker run --rm --entrypoint rclone rclone/rclone:1.68.2 obscure "su frase larga"
# (rclone obscure). Pegue el resultado. Una vez que hay copias, NO las cambie.
COPIA_CLAVE_CIFRADO=
COPIA_SAL_CIFRADO=

# Zona horaria.
TZ=America/Argentina/Mendoza
