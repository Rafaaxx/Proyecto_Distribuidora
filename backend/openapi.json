      "post": {
        "tags": [
          "identidad"
        ],
        "summary": "Crear Usuario",
        "description": "Change 04, grupo 11 (`design.md` D7): delega en el bus de comandos\n(`USUARIO_CREAR`, `identidad/commands.py`) en vez de llamar directo a\n`identidad_service.crear_usuario` (deuda nominada por el change 03, D6).\n`RecursoNoEncontradoError` si `rol_id` no pertenece a\n`entrada.contexto.organizacion_id` (SEG-07, INV-21, tarea 12.2). Un\nreenvío idéntico (mismo `Operation-Id`, mismo contenido) resuelve el\nmismo usuario ya creado -- se relee de la base para que la respuesta\nsea el estado real, no un valor cacheado del primer intento.",
        "operationId": "crear_usuario_api_v1_identidad_usuarios_post",
        "parameters": [
          {
            "name": "Operation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Operation-Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearUsuarioRequest"
              }
            }
          }
        },
        "responses": {
