# Entorno de ACEPTACION AUTOMATICA (change 28, D13; docs/02 §15, §16).
#
# Lo usa `npm run test:e2e` (frontend/scripts/aceptacion.mjs) para levantar el compose de
# produccion como un proyecto APARTE (`distribuidora-aceptacion`), con una base nueva y sus propios
# volumenes, correr la suite de Playwright y descartarlo todo (`down -v`). No toca el entorno de
# desarrollo ni el de produccion.
#
# Se versiona A PROPOSITO: todos los valores son de prueba, no sirven fuera de este entorno
# desechable. NUNCA copie aca un valor real.
#
# No ponga espacios alrededor del "=" ni comillas.

# Se sirve en localhost con la autoridad propia de Caddy. Los puertos son otros para no chocar con
# el perfil `lan` de desarrollo (80/443); Playwright entra por https://localhost:8443.
DOMINIO=localhost
CADDY_TLS=internal
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
# Otra subred interna: la 172.30.10.0/24 la ocupa el compose de produccion de este mismo equipo.
FRENTE_SUBRED=172.30.20.0/24

APP_VERSION=0.28.0
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
POSTGRES_USER=distribuidora
POSTGRES_DB=distribuidora
JWT_KID=1

# Secretos de PRUEBA, distintos entre si (INV-05).
POSTGRES_PASSWORD=prueba-aceptacion-superusuario-0001
APP_MIGRATIONS_DB_PASSWORD=prueba-aceptacion-migraciones-0002
APP_RUNTIME_DB_PASSWORD=prueba-aceptacion-runtime-0003
APP_BACKUP_DB_PASSWORD=prueba-aceptacion-respaldo-0004
APP_MANTENIMIENTO_DB_PASSWORD=prueba-aceptacion-mantenimiento-0005
JWT_SECRET=prueba-aceptacion-firma-de-sesiones-0006

# Carpetas del equipo (relativas a la raiz del repositorio, ignoradas por git).
BACKUP_DIR=./.aceptacion/backups
BACKUP_HORA=03:00
BACKUP_DIARIOS=14
BACKUP_SEMANALES=8
BACKUP_UID=999
BACKUP_GID=999
TAREAS_HORA=05:00
PRUEBA_DIA=1
PRUEBA_HORA=04:00

# Copia externa a una carpeta local (sin cuenta de nube): ensayo.
COPIA_TIPO=local
COPIA_RUTA=/destino-local/copias
COPIA_S3_ENDPOINT=
COPIA_S3_REGION=
COPIA_S3_PROVEEDOR=Other
COPIA_LOCAL_DIR=./.aceptacion/copia
AVISO_URL=
AVISO_TAREAS_URL=
COPIA_ACCESS_KEY_ID=no-aplica
COPIA_SECRET_ACCESS_KEY=no-aplica
COPIA_CLAVE_CIFRADO=no-aplica
COPIA_SAL_CIFRADO=no-aplica

TZ=America/Argentina/Mendoza
