            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "organizacion_slug": {
            "type": "string",
            "title": "Organizacion Slug"
          },
          "usuario": {
            "type": "string",
            "title": "Usuario"
          },
          "contrasena": {
            "type": "string",
            "title": "Contrasena"
          },
          "dispositivo_id": {
            "type": "string",
            "format": "uuid",
            "title": "Dispositivo Id"
          },
          "nombre_dispositivo": {
            "type": "string",
