# Copiar a .env.example (o directamente a .env) y ajustar si hace falta.
# Todos los valores tienen default en docker-compose.yml; este archivo
# documenta qué variables existen.

POSTGRES_USER=distribuidora
POSTGRES_PASSWORD=distribuidora
POSTGRES_DB=distribuidora

# Contraseñas de los dos roles de aplicación (ADR-020, INV-05).
# app_migrations es dueño del esquema y corre Alembic.
# app_runtime es el que usa el backend, con permisos acotados por tabla.
# Sin valor por defecto: Postgres y el backend fallan explícito si faltan.
APP_MIGRATIONS_DB_PASSWORD=distribuidora
APP_RUNTIME_DB_PASSWORD=distribuidora

# Usada por el backend fuera de Docker Compose (ej. corriendo pytest en local).
# Conecta como app_runtime: el backend en rus.
DATABASE_URL=postgresql+psycopg://app_runtime:distribuidora@localhost:5432/distribuidora

# Usada solo por Alembic para correr migracig.py).
DATABASE_URL_MIGRATIONS=postgresql+psycopg://app_migrations:distribuidora@localhost:5432/distribuidora

APP_VERSION=dev
LOG_LEVEL=INFO
ENVIRONMENT=development

VITE_API_BASE_URL=http://localhost:8000/api/

JWT_SECRET=clave-de-desarrollo-larga-y-aleatoria-cambiar-en-produccion