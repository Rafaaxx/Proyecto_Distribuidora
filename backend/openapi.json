        ],
        "title": "TokenResponse"
      },
      "UsuarioResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "usuario": {
            "type": "string",
            "title": "Usuario"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "rol_id": {
            "type": "string",
            "format": "uuid",
            "title": "Rol Id"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          }
        },
        "type": "object",
        "required": [
          "id",
          "usuario",
          "nombre",
          "email",
          "rol_id",
          "estado"
        ],
        "title": "UsuarioResponse",
        "description": "Tarea 10.8: sin `password_hash` ni las tres columnas del PIN de\nautorización -- Pydantic solo serializa los campos declarados acá, así\nque omitirlos de este modelo es la garantía, no un filtro posterior."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
